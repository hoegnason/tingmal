    <text>
      <body>
        <div>
          <head rend="bold center">Hvørjum man tykja vakurt hjá sær</head>
          <lg type="stanza">
            <l>
              <seg xml:id="xew4bvowaz">Hvørjum man tykja vakurt hjá sær,</seg>
            </l>
            <l>
              <seg xml:id="ofy6iu4a6d">vakrast í Føroyum tykir mær.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="fflo2ctsnc">Tað er so vakurt,</seg>
            </l>
            <l>
              <seg xml:id="f3fhfocvtt">so vakurt í Føroyum at búgva.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="ph6swswmyp">Føroyar, mín móðir, víst ert tú fríð</seg>
            </l>
            <l>
              <seg xml:id="jwac24cy4e">í grønum stakki um summartíð.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="bvln4s6pwm">Tá kvøld og morgun á vinahátt</seg>
            </l>
            <l>
              <seg xml:id="wpyqq34465">blídliga heilsast um miðju nátt.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="kcfoq7fiqt">Og havið, troytt av at berjast við teg,</seg>
            </l>
            <l>
              <seg xml:id="tw33crkgwz">við tínar føtur hvílir seg.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="pwyvcg5tl3">Føroyar, mín móðir, víst ert tú prúð,</seg>
            </l>
            <l>
              <seg xml:id="hquvxxx335">tá ið tú klæðist í vetrarskrúð.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="qbt25vgrco">Víst ert tú, móðir, føgur og fín,</seg>
            </l>
            <l>
              <seg xml:id="whj7vxq5sv">klædd í hitt skínandi hvíta lín.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="ib6qqkaski">Tá glampar á himli stjørnulind,</seg>
            </l>
            <l>
              <seg xml:id="zapjhemzq2">norðlýsið blaktrar um fjallatind.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="a3cjb5iul4">Uppal tíni børn sum móðir rætt,</seg>
            </l>
            <l>
              <seg xml:id="zg2k62zski">lat tey ei bregða burtur úr ætt.</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="pojectte7l">Gev teimum Tróndar skarpa vit,</seg>
            </l>
            <l>
              <seg xml:id="qnofg4mmpd">men Sigmunds bjarta hjartalit!</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="semlqqvu7n">Gev teimum tolgóða, sterka sál,</seg>
            </l>
            <l>
              <seg xml:id="jfnqlim4hf">gev teimum Sverris vilja sum stál.</seg>
            </l>
          </lg>
        </div>
      </body>
    </text>
