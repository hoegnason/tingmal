    <text>
      <body>
        <div>
          <head rend="bold center">Deyði, hvar er nú broddur tín</head>
          <lg type="stanza">
            <l>
              <seg xml:id="ucqm6d7o5g">Deyði, hvar er nú broddur tín?</seg>
            </l>
            <l>
              <seg xml:id="d6zgdm3f34">Helviti, hvar er tín sigur?</seg>
            </l>
            <l>
              <seg xml:id="a5xwf5nu5h">Risin er aftur frelsari mín,</seg>
            </l>
            <l>
              <seg xml:id="zb7fjkpf7m">áður í grøv lagdur niður.</seg>
            </l>
            <l>
              <seg xml:id="bvvhre5tn2">Roðar nú páskasól um fjøll,</seg>
            </l>
            <l>
              <seg xml:id="nzld4bknfs">vermir og gleðir hjørtu øll!</seg>
            </l>
            <l>
              <seg xml:id="hyru4adji2">Tøkk havi Guð fyri lívið!</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="rop6clbfgh">Lívsleiðin er ei meira tung;</seg>
            </l>
            <l>
              <seg xml:id="ahfow7zq7v">livandi Jesus meg leiðir;</seg>
            </l>
            <l>
              <seg xml:id="u5a6xei3iz">bæði hann styðjar gomul og ung,</seg>
            </l>
            <l>
              <seg xml:id="eibgxvii37">breytina fyri teim greiðir.</seg>
            </l>
            <l>
              <seg xml:id="khqiyb7bgl">Fylgir hann við á míni ferð,</seg>
            </l>
            <l>
              <seg xml:id="t53fcl4sfi">einki mær tá til skaða er.</seg>
            </l>
            <l>
              <seg xml:id="kpn4tfni4j">Tøkk havi Guð fyri lívið!</seg>
            </l>
          </lg>
          <lg type="stanza">
            <l>
              <seg xml:id="y3doetxhbu">Songur tí berst um lond og høv</seg>
            </l>
            <l>
              <seg xml:id="cfwtlmptv7">um páskaboðskapin bjarta,</seg>
            </l>
            <l>
              <seg xml:id="cktvujfim3">fagurt hann ljóðar við opna grøv</seg>
            </l>
            <l>
              <seg xml:id="fyljdl4sqx">inn í tað trúgvandi hjarta:</seg>
            </l>
            <l>
              <seg xml:id="fv6b25giak">“Risin av grøv er frelsari mín,</seg>
            </l>
            <l>
              <seg xml:id="qqujf6vmfl">deyði, hvar er nú broddur tín?”</seg>
            </l>
            <l>
              <seg xml:id="vus3s4mspa">Tøkk havi Guð fyri lívið!</seg>
            </l>
          </lg>
        </div>
      </body>
    </text>
