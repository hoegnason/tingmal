      <div type="chapter" n="3">
        <head rend="bold"><label>Kap. 3.</label> Serligar viðmerkingar</head>
        <div type="section">
          <head rend="bold">Til § 1</head>
          <p>
            <s xml:lang="fo" cert="high" xml:id="h46y7fyafa">Ásetingin ber í sær, at alt arvaavgjaldið fer í landskassan, í staðin fyri at skula býtast millum landskassan og ríkiskassan.</s>
          </p>
        </div>
        <div type="section">
          <head rend="bold">Til § 2</head>
          <p>
            <seg xml:lang="fo">Áseting av gildiskomu.</seg>
          </p>
        </div>
