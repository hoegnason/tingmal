      <div type="chapter" n="3">
        <head rend="bold"><label>Kap. 3.</label> Serligar viðmerkingar</head>
        <div type="section">
          <head rend="bold">Til § 1:</head>
          <p>
            <s xml:lang="fo" cert="high" xml:id="udpqneol6u">Lógarbroytingin hevur við sær, at almannaveitingarnar sambært hesari lóg frameftir verða javnaðar við 3% árliga.</s>
          </p>
        </div>
        <div type="section">
          <head rend="bold">Til § 2:</head>
          <p>
            <seg xml:lang="fo">Gildiskomuregla.</seg>
          </p>
        </div>
