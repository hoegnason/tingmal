      <div type="chapter" n="3">
        <head rend="bold"><label>Kap. 3.</label> Serligar viðmerkingar</head>
        <div type="section">
          <head rend="bold">Til § 1:</head>
          <p>
            <s xml:lang="fo" cert="high" xml:id="jnx5hzpfwk">Broytingin ásetur, at gjaldið til Barsilsskipanina verður hækkað frá 0,62% til 0,68%.</s>
          </p>
