      <div type="chapter" n="3">
        <head rend="bold"><label>Kap. 3</label> – Serligar viðmerkingar</head>
        <div type="section">
          <head rend="bold">Til § 1</head>
          <p>
            <s xml:lang="fo" cert="high" xml:id="we475yyhi5">Gjaldið sambært § 1 í løgtingslóg um tinglýsingargjøld v.m. fellur til landskassan.</s>
          </p>
