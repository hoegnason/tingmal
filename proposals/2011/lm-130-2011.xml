            </row>
          </table>
        </div>
      </div>
      <div type="chapter" n="3">
        <head rend="bold"><label>Kap. 3.</label> Serligar viðmerkingar</head>
        <div type="section">
          <head rend="bold">Til § 1</head>
          <p>
            <s xml:lang="fo" cert="high" xml:id="a7lpomoxmm">Ásetingin um kostnaðarendurgjald, sum landsstýrisfólk kunnu fáa ístaðin fyri frí hús, verður strikað.</s>
          </p>
        </div>
        <div type="section">
          <head rend="bold">Til § 2</head>
          <p>
            <seg xml:lang="fo">Áseting um gildiskomu.</seg>
          </p>
        </div>
      </div>
